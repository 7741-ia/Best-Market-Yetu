rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Current shared marketplace state. A future data-model migration should
    // split this into public and per-user documents before production.
    match /bmy/state {
      allow read, write: if true;
    }

    match /products/{productId}/comments/{commentId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.userName is string
                    && request.resource.data.userName.size() > 0
                    && request.resource.data.userName.size() <= 80
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 400;
      allow update: if false;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    match /reservations/{productId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.productId == productId
                    && request.resource.data.buyerId == request.auth.uid
                    && request.resource.data.buyerName is string
                    && request.resource.data.buyerName.size() > 0
                    && request.resource.data.buyerName.size() <= 80
                    && request.resource.data.expiresAt is timestamp
                    && request.resource.data.expiresAt > request.time;
      // A new buyer can replace an expired reservation, but cannot replace an active one.
      allow update: if request.auth != null
                    && resource.data.expiresAt <= request.time
                    && request.resource.data.productId == productId
                    && request.resource.data.buyerId == request.auth.uid
                    && request.resource.data.buyerName is string
                    && request.resource.data.buyerName.size() > 0
                    && request.resource.data.buyerName.size() <= 80
                    && request.resource.data.expiresAt is timestamp
                    && request.resource.data.expiresAt > request.time;
      allow delete: if request.auth != null && resource.data.buyerId == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
